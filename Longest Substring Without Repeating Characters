class Solution {
    public int lengthOfLongestSubstring(String s) {
        int l=0;
        HashSet<Character> ans = new HashSet<>();
        int max = 0;
        for(int i=0;i<s.length();i++){
            while(ans.contains(s.charAt(i))){
                ans.remove(s.charAt(l));
                l++;
            }
            ans.add(s.charAt(i));
            max = Math.max(max,i-l+1);
        }
        return max;
    }
}
