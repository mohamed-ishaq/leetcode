class Solution {
    public boolean isPalindrome(int x) {
        int orginal_number = x;
        int reversed_number = 0;
        int reminder;
        while(x>0){
            reminder = x%10;
            reversed_number = reversed_number * 10 + reminder;
            x = x/10;
        }
        if(orginal_number == reversed_number){
            return true;
        }
        return false;
    }
}
