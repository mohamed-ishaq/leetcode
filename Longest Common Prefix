class Solution {
    public String longestCommonPrefix(String[] strs) {
        if (strs == null || strs.length == 0) {
            return "";
        }
        String firstStr = strs[0];
        int pos = 0;
        while (true) {
            if (pos >= firstStr.length()) {
                break; 
            }

            char currentChar = firstStr.charAt(pos);
            for (int i = 1; i < strs.length; i++) {
                if (pos >= strs[i].length() || strs[i].charAt(pos) != currentChar) {
                    return firstStr.substring(0, pos);
                }
            }
            pos++;
        }
        return firstStr.substring(0, pos);
    }
}
